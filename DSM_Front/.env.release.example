# Copy to .env.release.local; replace every placeholder before release validation.
# These URLs and the public client identifier are embedded in the APK; never add secrets here.
API_BASE_URL=https://api.example.invalid
GOOGLE_WEB_CLIENT_ID=
# Optional Kakao native public key and Apple Services ID / registered HTTPS redirect.
KAKAO_NATIVE_APP_KEY=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
PRIVACY_POLICY_URL=https://legal.example.invalid/privacy
ACCOUNT_DELETION_URL=https://legal.example.invalid/privacy#account-deletion
