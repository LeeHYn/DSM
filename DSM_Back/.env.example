NODE_ENV=development
PORT=3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dsm
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dsm?schema=public"
JWT_ACCESS_SECRET="replace-with-at-least-32-characters-access-secret"
JWT_REFRESH_SECRET="replace-with-at-least-32-characters-refresh-secret"
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id.apps.googleusercontent.com"
FCM_DISPATCH_ENABLED=false
FCM_PROJECT_ID="replace-with-your-firebase-project-id"
REDIS_URL="redis://127.0.0.1:6379"
REDIS_PORT=6379
CORS_ORIGINS="http://localhost:8081,http://127.0.0.1:8081"
